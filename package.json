{
  "name": "dsh-qq-bridge-whale",
  "version": "1.1.2-whale.1",
  "description": "通到 QQ（大肥鱼分叉）：DSH 里的 AI 伙伴和 QQ 双向互通 —— 它说完话自动发到 QQ，你在 QQ 里说的话自动转进 DSH。走 OneBot 11 HTTP（SnowLuma / NapCat 都行）。",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  },
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/host.js",
    "lib/client.js",
    "lib/selfupdate.mjs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "tools/asr_cli.py"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "author": "Yuuyuko-uu (https://github.com/Yuuyuko-uu)",
  "contributors": [
    {
      "name": "getalucky",
      "url": "https://github.com/getalucky"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getalucky/dsh-qq-bridge-whale.git"
  },
  "homepage": "https://github.com/getalucky/dsh-qq-bridge-whale#readme",
  "bugs": {
    "url": "https://github.com/getalucky/dsh-qq-bridge-whale/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "qq",
    "fork"
  ]
}
